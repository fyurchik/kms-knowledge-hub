# P3. Скільки аварійних ремонтів виконав кожен працівник і на яку суму?
PREFIX res:  <https://kms.lnu.edu.ua/fenyn/res#>
PREFIX id:   <https://kms.lnu.edu.ua/fenyn/res/id/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
SELECT ?employee (COUNT(?w) AS ?repairs) (SUM(?cost) AS ?totalEUR) WHERE {
  ?w a res:CorrectiveRepair ; res:performedBy ?p ; res:costEUR ?cost .
  ?p rdfs:label ?employee .
}
GROUP BY ?employee
ORDER BY DESC(?totalEUR)
