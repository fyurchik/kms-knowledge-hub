digraph S {
graph [rankdir=LR, nodesep=0.35, ranksep=0.9, fontname="Liberation Sans", pad=0.2, splines=true];
node [shape=plain, fontname="Liberation Sans"];
edge [fontname="Liberation Sans", fontsize=10, color="#555555", arrowsize=0.7];
Region [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" bgcolor="#eef4fb" color="#1f4e79"><tr><td bgcolor="#1f4e79"><font color="white"><b>:Region</b></font></td></tr><tr><td align="left"><font point-size="9">id, name</font></td></tr></table>>];
Company [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" bgcolor="#eef4fb" color="#1f4e79"><tr><td bgcolor="#1f4e79"><font color="white"><b>:Company</b></font></td></tr><tr><td align="left"><font point-size="9">id, name, taxId</font></td></tr></table>>];
GridNode [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" bgcolor="#eef4fb" color="#1f4e79"><tr><td bgcolor="#1f4e79"><font color="white"><b>:GridNode</b></font></td></tr><tr><td align="left"><font point-size="9">id, name, voltageKV</font></td></tr></table>>];
Plant [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" bgcolor="#eef4fb" color="#1f4e79"><tr><td bgcolor="#1f4e79"><font color="white"><b>:Plant</b></font></td></tr><tr><td align="left"><font point-size="9">id, name, installedCapacityMW,<br/>commissioningDate</font></td></tr><tr><td align="left"><font point-size="9" color="#555555">:WindFarm | :SolarPlant</font></td></tr></table>>];
Equipment [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" bgcolor="#eef4fb" color="#1f4e79"><tr><td bgcolor="#1f4e79"><font color="white"><b>:Equipment</b></font></td></tr><tr><td align="left"><font point-size="9">id, name, kind, model,<br/>ratedPowerKW, stateOfHealth</font></td></tr><tr><td align="left"><font point-size="9" color="#555555">:WindTurbine :PVArray :Inverter<br/>:Transformer :Substation :Sensor …</font></td></tr></table>>];
Component [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" bgcolor="#eef4fb" color="#1f4e79"><tr><td bgcolor="#1f4e79"><font color="white"><b>:Component</b></font></td></tr><tr><td align="left"><font point-size="9">id, name, kind</font></td></tr><tr><td align="left"><font point-size="9" color="#555555">:Rotor :Gearbox :Generator</font></td></tr></table>>];
Measurement [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" bgcolor="#eef4fb" color="#1f4e79"><tr><td bgcolor="#1f4e79"><font color="white"><b>:Measurement</b></font></td></tr><tr><td align="left"><font point-size="9">id, value, unit, observedAt</font></td></tr></table>>];
Event [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" bgcolor="#eef4fb" color="#1f4e79"><tr><td bgcolor="#1f4e79"><font color="white"><b>:Event</b></font></td></tr><tr><td align="left"><font point-size="9">id, name, kind, occurredAt,<br/>severity, durationH</font></td></tr><tr><td align="left"><font point-size="9" color="#555555">:FailureEvent :AlarmEvent<br/>:CurtailmentEvent</font></td></tr></table>>];
MaintenanceWork [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" bgcolor="#eef4fb" color="#1f4e79"><tr><td bgcolor="#1f4e79"><font color="white"><b>:MaintenanceWork</b></font></td></tr><tr><td align="left"><font point-size="9">id, name, kind, costEUR, startedAt</font></td></tr><tr><td align="left"><font point-size="9" color="#555555">:CorrectiveRepair<br/>:PlannedMaintenance</font></td></tr></table>>];
Employee [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" bgcolor="#eef4fb" color="#1f4e79"><tr><td bgcolor="#1f4e79"><font color="white"><b>:Employee</b></font></td></tr><tr><td align="left"><font point-size="9">id, name, position, email</font></td></tr></table>>];
SparePart [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" bgcolor="#eef4fb" color="#1f4e79"><tr><td bgcolor="#1f4e79"><font color="white"><b>:SparePart</b></font></td></tr><tr><td align="left"><font point-size="9">id, name, unitCostEUR</font></td></tr></table>>];
Record [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" bgcolor="#eef4fb" color="#1f4e79"><tr><td bgcolor="#1f4e79"><font color="white"><b>:Record</b></font></td></tr><tr><td align="left"><font point-size="9">id, number, date</font></td></tr></table>>];
Forecast [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" bgcolor="#eef4fb" color="#1f4e79"><tr><td bgcolor="#1f4e79"><font color="white"><b>:Forecast</b></font></td></tr><tr><td align="left"><font point-size="9">id, forecastDate, forecastMWh</font></td></tr></table>>];
WeatherData [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" bgcolor="#eef4fb" color="#1f4e79"><tr><td bgcolor="#1f4e79"><font color="white"><b>:WeatherData</b></font></td></tr><tr><td align="left"><font point-size="9">id, windSpeedMS, irradianceWm2</font></td></tr></table>>];
ControlRule [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" bgcolor="#eef4fb" color="#1f4e79"><tr><td bgcolor="#1f4e79"><font color="white"><b>:ControlRule</b></font></td></tr><tr><td align="left"><font point-size="9">id, name, conditionText</font></td></tr></table>>];
ControlRule -> Equipment [label="CONTROLS"];
Employee -> Company [label="EMPLOYED_BY"];
Equipment -> Equipment [label="DEPENDS_ON"];
Equipment -> GridNode [label="DEPENDS_ON"];
Equipment -> Component [label="HAS_PART"];
Equipment -> Plant [label="INSTALLED_AT"];
Equipment -> Equipment [label="OBSERVES"];
Event -> Equipment [label="AFFECTS"];
Event -> Event [label="CAUSED_BY"];
Event -> Record [label="DOCUMENTED_IN"];
Forecast -> WeatherData [label="BASED_ON"];
Forecast -> Plant [label="FORECAST_FOR"];
MaintenanceWork -> Employee [label="PERFORMED_BY"];
MaintenanceWork -> Equipment [label="TARGETS"];
MaintenanceWork -> Event [label="TRIGGERED_BY"];
MaintenanceWork -> SparePart [label="USES_PART"];
Measurement -> Equipment [label="MEASURED_BY"];
Plant -> Region [label="LOCATED_IN"];
Plant -> Company [label="OPERATED_BY"];
note [shape=note, fontsize=9, label="На всіх зв'язках: source, confidence, validFrom\nНа всіх вузлах: додаткова мітка :Entity (унікальний id)"];
}